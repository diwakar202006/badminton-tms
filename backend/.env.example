# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/badminton_tms?retryWrites=true&w=majority

# JWT secret - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS / Socket.IO
CLIENT_ORIGIN=http://localhost:5173

# One-time bootstrap admin (central scorer) created by utils/seed.js
ADMIN_NAME=Central Admin
ADMIN_EMAIL=admin@tournament.com
ADMIN_PASSWORD=ChangeMe123!
